# AniList OAuth credentials (required for AniList login in Shiori).
# Copy this file to `.env` at the repo root, fill in your values, and rebuild.
# The secrets are injected at compile time via src-tauri/build.rs
# (option_env! in src-tauri/src/commands/anilist.rs) — builds without them
# still compile, but AniList OAuth will fail with a clear error.
#
# SECURITY: never commit real secrets. Set them locally or in CI only.

ANILIST_DESKTOP_CLIENT_ID=
ANILIST_DESKTOP_CLIENT_SECRET=
ANILIST_ANDROID_CLIENT_ID=
ANILIST_ANDROID_CLIENT_SECRET=