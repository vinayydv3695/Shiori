{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiori",
  "version": "2.3.10",
  "identifier": "io.github.vinayydv3695.shiori",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "tsc -b && vite build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "2026 Shiori Contributors",
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/espeak-ng-data/**/*"
    ],
    "fileAssociations": [
      { "ext": ["epub"], "mimeType": "application/epub+zip", "name": "EPUB Book", "role": "Viewer" },
      { "ext": ["pdf"],  "mimeType": "application/pdf",       "name": "PDF",       "role": "Viewer" },
      { "ext": ["cbz"],  "mimeType": "application/vnd.comicbook+zip", "name": "Comic (CBZ)", "role": "Viewer" },
      { "ext": ["mobi"], "mimeType": "application/x-mobipocket-ebook", "name": "MOBI", "role": "Viewer" },
      { "ext": ["azw3"], "mimeType": "application/vnd.amazon.ebook",   "name": "AZW3", "role": "Viewer" },
      { "ext": ["fb2"],  "mimeType": "application/x-fictionbook+xml",  "name": "FB2",  "role": "Viewer" }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": ""
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-common",
          "libspeechd2"
        ],
        "section": "utils"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator-gtk3",
          "librsvg2",
          "speech-dispatcher"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; worker-src 'self' blob: asset: http://asset.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: blob: data: shiori-proxy: http://shiori-proxy.localhost https://shiori-proxy.localhost; media-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost http://asset.localhost https://asset.localhost https://www.googleapis.com https://openlibrary.org https://covers.openlibrary.org https://graphql.anilist.co https://api.mangadex.org https://gutendex.com https://freeonlinek.top https://weebrook.com https://api.github.com https://mangafire.to",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**",
          "$APPDATA/**",
          "$HOME/**",
          "/tmp/**",
          "$TEMP/**"
        ]
      },
      "capabilities": [
        "default",
        "android-capability",
        "desktop-capability",
        "tts-capability"
      ]
    },
    "windows": []
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vinayydv3695/Shiori/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NTY5ODY4ODAwMjg3M0MKUldROGh3S0FhSmhXSk5NNmp2dUJueGtTVi8rZjZvTHhGb0d3QlJLRDZ2LzdFUFFYeWd6cDRTYzMK"
    }
  }
}
